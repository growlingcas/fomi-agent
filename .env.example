# ── режим работы ───────────────────────────────────────────────
# paper  — бумажная торговля по реальным ценам (по умолчанию, безопасно)
# manual — мозг решает, а покупаешь ты руками и подтверждаешь через `npm run confirm`
# phone  — торгует сама через приложение fomo на облачном телефоне (VMOS / эмулятор / Android)
EXECUTOR=paper
MOCK=0                      # 1 = фейковые токены без интернета (для теста)

# ── банк ───────────────────────────────────────────────────────
# Пресет под стартовый депозит ~$10. START_BANK_SOL = сколько реально лежит на кошельке в fomo.
START_BANK_SOL=0.06
RESERVE_SOL=0.01            # неприкосновенный резерв на комиссии, не торгуется
BASE_PCT=0.2                # базовая ставка = 20% торгуемого банка × уверенность
MIN_POSITION_SOL=0.005
MAX_POSITION_SOL=0.015
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT_SOL=0.012
HALT_EQUITY_SOL=0.03        # если equity ниже — стоп до ручного `npm run resume`
# Пресет под 5 SOL: START_BANK_SOL=5 RESERVE_SOL=1 BASE_PCT=0.06 MIN_POSITION_SOL=0.1 MAX_POSITION_SOL=0.5
#                   MAX_OPEN_POSITIONS=4 DAILY_LOSS_LIMIT_SOL=0.75 HALT_EQUITY_SOL=2.5

# ── мозг (LLM) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=          # пусто = решения по правилам, без LLM
LLM_MODEL=claude-haiku-4-5-20251001
TICK_SECONDS=120

# ── GMGN (чтение: тренды, smart money, rug ratio, холдеры) ───
GMGN_API_KEY=               # ключ с gmgn.ai/ai, только Reading. Торговля через GMGN не нужна

# ── X (twitter) ────────────────────────────────────────────────
X_POST=0                    # 1 = реально постить, 0 = только в brain/data/outbox.json
X_USER_TOKEN=               # OAuth2 user-context token с правом tweet.write
X_BEARER_TOKEN=             # app bearer для поиска твитов (опционально)
X_API_BASE=https://api.twitter.com

# ── телефон (EXECUTOR=phone) ───────────────────────────────────
PHONE_TRANSPORT=vmos        # vmos — OpenAPI VMOS Cloud; adb — эмулятор / телефон по ADB
PHONE_SERIAL=               # только для adb: адрес вида 1.2.3.4:5555
PHONE_DRY_RUN=1             # 1 = проходит весь путь, но НЕ жмёт финальное подтверждение. 0 = реальные сделки
PHONE_STEP_DELAY_MS=900
PHONE_FPS=1                 # кадров экрана в секунду для сайта
VMOS_AK=                    # Access Key ID   (кабинет VMOS → Developer → API)
VMOS_SK=                    # Secret Access Key
VMOS_PAD_CODE=              # Cloud phone ID, напр. ACP...

# ── live-сервер (npm run live) ─────────────────────────────────
LIVE_PORT=8787
LIVE_ALLOW_ORIGIN=*         # лучше поставить адрес сайта, напр. https://you.github.io

# ── fomo ───────────────────────────────────────────────────────
FOMO_URL=https://fomo.family      # ← сюда реф-ссылку
FOMO_API_BASE=
FOMO_API_KEY=

# ── ссылки на сайте ────────────────────────────────────────────
X_HANDLE=fomi
GITHUB_URL=https://github.com/growlingcas/fomi-agent
